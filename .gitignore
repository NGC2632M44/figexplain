# ---- Secrets / credentials ----
# Local config holds API keys — never commit it (lives in ~/.figexplain/ anyway,
# but guard against any stray local copy).
config.json
.figma*
*.env
.env
.env.*
secrets.*
*_secret*

# ---- Private / generated outputs ----
# Local note HTML dumps and extracted images are user-specific.
figexplain_*.html
*_note.html
*_smoke*.html
manifest.json
fig_extract.json
# 训练/批量验证产物(JSON + HTML,含 base64 图,体积大,不入库)
validation/

